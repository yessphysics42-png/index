<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>مسابقة النشاط الشهري - مدرسة المنار القرآنية</title>
  
  <!-- خط تجولي العربي -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --primary-color: #0f766e;
      --primary-hover: #0d9488;
      --bg-color: #f0fdfa;
      --card-bg: rgba(255, 255, 255, 0.95);
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border-color: #ccfbf1;
      --input-bg: #ffffff;
      --card-shadow: 0 10px 25px -5px rgba(15, 118, 110, 0.08);
      --danger-color: #ef4444;
    }

    body.dark-mode {
      --bg-color: #0f172a;
      --card-bg: rgba(30, 41, 59, 0.95);
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --border-color: #334155;
      --input-bg: #1e293b;
      --card-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Tajawal', sans-serif;
      transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
    }

    body {
      background-color: var(--bg-color);
      background-image: 
        radial-gradient(circle at 10% 20%, rgba(15, 118, 110, 0.12) 0%, transparent 20%),
        radial-gradient(circle at 90% 80%, rgba(13, 148, 136, 0.12) 0%, transparent 25%);
      background-attachment: fixed;
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px 16px;
    }

    main {
      width: 100%;
      max-width: 650px;
      position: relative;
    }

    .theme-toggle-btn {
      position: absolute;
      top: 0;
      left: 0;
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      padding: 6px 12px;
      border-radius: 20px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 6px;
      box-shadow: var(--card-shadow);
      z-index: 10;
    }

    header {
      text-align: center;
      margin-bottom: 24px;
      margin-top: 10px;
      background: var(--card-bg);
      backdrop-filter: blur(8px);
      padding: 20px;
      border-radius: 16px;
      border: 1px solid var(--border-color);
      box-shadow: var(--card-shadow);
    }

    .logo-img {
      max-width: 110px;
      height: auto;
      margin-bottom: 10px;
    }

    .subtitle {
      font-size: 13px;
      color: var(--primary-color);
      font-weight: 700;
      background: rgba(15, 118, 110, 0.1);
      padding: 4px 10px;
      border-radius: 10px;
      display: inline-block;
      margin-bottom: 6px;
    }

    h1 {
      font-size: 20px;
      font-weight: 700;
      color: var(--text-main);
      line-height: 1.4;
    }

    .form-card {
      background: var(--card-bg);
      backdrop-filter: blur(8px);
      border-radius: 16px;
      padding: 20px;
      box-shadow: var(--card-shadow);
      border: 1px solid var(--border-color);
      margin-bottom: 24px;
    }

    .form-group {
      margin-bottom: 14px;
    }

    .form-card label {
      display: block;
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 6px;
      font-weight: 700;
    }

    input[type="text"], textarea {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid var(--border-color);
      border-radius: 10px;
      font-size: 14px;
      outline: none;
      background-color: var(--input-bg);
      color: var(--text-main);
    }

    input[type="file"] {
      font-size: 13px;
      color: var(--text-muted);
    }

    textarea {
      height: 75px;
      resize: none;
    }

    input:focus, textarea:focus {
      border-color: var(--primary-color);
    }

    .btn-submit {
      width: 100%;
      background-color: var(--primary-color);
      color: #ffffff;
      border: none;
      padding: 12px;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      margin-top: 6px;
      transition: background 0.2s;
    }

    .btn-submit:hover {
      background-color: var(--primary-hover);
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 12px;
    }

    .section-header h3 {
      font-size: 18px;
      color: var(--text-main);
    }

    .section-header small {
      color: var(--text-muted);
      font-size: 12px;
    }

    .activities-list {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .activity-card {
      background: var(--card-bg);
      backdrop-filter: blur(8px);
      border-radius: 16px;
      padding: 18px;
      border: 1px solid var(--border-color);
      box-shadow: var(--card-shadow);
    }

    .activity-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 8px;
    }

    .teacher-name {
      font-weight: 700;
      color: var(--primary-color);
      font-size: 15px;
    }

    .activity-title {
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .activity-info {
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 6px;
    }

    .activity-media {
      margin: 12px 0;
      text-align: center;
    }

    .activity-media img, .activity-media video {
      max-width: 100%;
      max-height: 220px;
      border-radius: 10px;
      object-fit: cover;
      border: 1px solid var(--border-color);
    }

    .card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 12px;
    }

    .like-btn {
      background: var(--input-bg);
      border: 1px solid var(--border-color);
      padding: 6px 14px;
      border-radius: 20px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      color: var(--text-main);
      font-weight: 700;
    }

    .like-btn.liked {
      background: #fdf4ff;
      color: #0f766e;
      border-color: #5eead4;
    }

    .delete-btn {
      background: none;
      border: none;
      color: var(--danger-color);
      font-size: 12px;
      cursor: pointer;
      font-weight: 500;
      display: none;
    }

    body.is-admin .delete-btn {
      display: inline-block;
    }

    .votes-counter {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-muted);
    }
  </style>
</head>
<body>

  <main>
    <button class="theme-toggle-btn" onclick="toggleTheme()">
      <span id="themeIcon">🌙</span> <span id="themeText">الوضع الليلي</span>
    </button>

    <header>
      <img src="logo.png" alt="الشعار" class="logo-img" id="logo" onerror="this.style.display='none'">
      <span class="subtitle">مسابقة التميز التربوي</span>
      <h1>جائزة النشاط المتميز لشهر أكتوبر 2026</h1>
    </header>

    <div class="form-card">
      <h3 style="font-size:16px; margin-bottom:12px; color:var(--primary-color);">📤 إرسال نشاط جديد للمشاركة</h3>
      
      <div class="form-group">
        <label>اسم الأستاذ المشارك:</label>
        <input type="text" id="teacherName" placeholder="أدخل اسمك الكامل...">
      </div>

      <div class="form-group">
        <label>موضوع أو عنوان النشاط:</label>
        <input type="text" id="activityTitle" placeholder="مثال: ورشة الإملاء التفاعلي...">
      </div>

      <div class="form-group">
        <label>الفئة المستهدفة:</label>
        <input type="text" id="targetAudience" placeholder="مثال: السنة الأولى ابتدائي...">
      </div>

      <div class="form-group">
        <label>الهدف التربوي من النشاط:</label>
        <textarea id="educationalGoal" placeholder="اكتب باختصار الهدف التربوي المرجو..."></textarea>
      </div>

      <div class="form-group">
        <label>إرفاق صورة أو فيديو للنشاط:</label>
        <input type="file" id="mediaFile" accept="image/*,video/*">
      </div>

      <button class="btn-submit" onclick="submitActivity()">نشر النشاط في المسابقة</button>
    </div>

    <div class="section-header">
      <h3>الأنشطة المشاركة</h3>
      <small>مرتّبة حسب عدد الإعجابات (أقصى 3 إعجابات لكل أستاذ)</small>
    </div>

    <div id="activitiesContainer" class="activities-list">
      جاري تحميل الأنشطة...
    </div>
  </main>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
    import { 
      getFirestore, 
      collection, 
      addDoc, 
      onSnapshot, 
      doc, 
      updateDoc, 
      deleteDoc,
      increment, 
      orderBy, 
      query, 
      serverTimestamp 
    } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

    const firebaseConfig = {
      apiKey: "AIzaSyD6ZVsR7CXZIvjaSYC9OKGmxykHM-mM4So",
      authDomain: "nadwa-8efe3.firebaseapp.com",
      projectId: "nadwa-8efe3",
      storageBucket: "nadwa-8efe3.firebasestorage.app",
      messagingSenderId: "308417718764",
      appId: "1:308417718764:web:117367cad262d6da84f8c9",
      measurementId: "G-TPYEW9YG9Z"
    };

    const app = initializeApp(firebaseConfig);
    const db = getFirestore(app);
    const activitiesRef = collection(db, "teacher_activities");

    window.toggleTheme = function() {
      const isDark = document.body.classList.toggle('dark-mode');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateThemeUI(isDark);
    };

    function updateThemeUI(isDark) {
      document.getElementById('themeIcon').innerText = isDark ? '☀️' : '🌙';
      document.getElementById('themeText').innerText = isDark ? 'الوضع النهاري' : 'الوضع الليلي';
    }

    if (localStorage.getItem('theme') === 'dark') {
      document.body.classList.add('dark-mode');
      updateThemeUI(true);
    }

    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('admin') === 'true') {
      document.body.classList.add('is-admin');
    }

    let userLikes = JSON.parse(localStorage.getItem('teacherLikes') || '[]');

    window.submitActivity = async function() {
      const teacher = document.getElementById("teacherName").value.trim();
      const title = document.getElementById("activityTitle").value.trim();
      const target = document.getElementById("targetAudience").value.trim();
      const goal = document.getElementById("educationalGoal").value.trim();
      const fileInput = document.getElementById("mediaFile");

      if (!teacher || !title || !target || !goal) {
        alert("يرجى ملء جميع الحقول المطلوبة!");
        return;
      }

      let mediaUrl = "";
      if (fileInput.files.length > 0) {
        const file = fileInput.files[0];
        const reader = new FileReader();
        reader.onload = async function(e) {
          mediaUrl = e.target.result;
          await saveToFirestore(teacher, title, target, goal, mediaUrl);
        };
        reader.readAsDataURL(file);
      } else {
        await saveToFirestore(teacher, title, target, goal, "");
      }
    };

    async function saveToFirestore(teacher, title, target, goal, mediaUrl) {
      try {
        await addDoc(activitiesRef, {
          teacher: teacher,
          title: title,
          target: target,
          goal: goal,
          mediaUrl: mediaUrl,
          likes: 0,
          createdAt: serverTimestamp()
        });
        document.getElementById("teacherName").value = "";
        document.getElementById("activityTitle").value = "";
        document.getElementById("targetAudience").value = "";
        document.getElementById("educationalGoal").value = "";
        document.getElementById("mediaFile").value = "";
        alert("تم إرسال نشاطك بنجاح للمسابقة!");
      } catch (error) {
        alert("حدث خطأ أثناء الإرسال!");
      }
    }

    window.toggleLike = async function(id) {
      const isLiked = userLikes.includes(id);
      
      if (!isLiked && userLikes.length >= 3) {
        alert("عذراً، لقد استهلكت الحد الأقصى للأصوات (3 إعجابات فقط). يمكنك إلغاء إعجاب سابق لتصويت لآخر.");
        return;
      }

      const qDoc = doc(db, "teacher_activities", id);

      if (isLiked) {
        await updateDoc(qDoc, { likes: increment(-1) });
        userLikes = userLikes.filter(item => item !== id);
      } else {
        await updateDoc(qDoc, { likes: increment(1) });
        userLikes.push(id);
      }

      localStorage.setItem('teacherLikes', JSON.stringify(userLikes));
    };

    window.deleteActivity = async function(id) {
      if (confirm("هل أنت متأكد من حذف هذا النشاط؟")) {
        await deleteDoc(doc(db, "teacher_activities", id));
      }
    };

    const qQuery = query(activitiesRef, orderBy("likes", "desc"));
    onSnapshot(qQuery, (snapshot) => {
      const container = document.getElementById("activitiesContainer");
      container.innerHTML = "";

      if (snapshot.empty) {
        container.innerHTML = "<p style='text-align:center; color:var(--text-muted); padding: 20px;'>لا توجد أنشطة مشاركة بعد. كن أول من يشارك!</p>";
        return;
      }

      snapshot.forEach((docSnap) => {
        const data = docSnap.data();
        const id = docSnap.id;
        const isLiked = userLikes.includes(id);

        let mediaHtml = "";
        if (data.mediaUrl) {
          if (data.mediaUrl.startsWith("data:video")) {
            mediaHtml = `<div class="activity-media"><video controls src="${data.mediaUrl}"></video></div>`;
          } else {
            mediaHtml = `<div class="activity-media"><img src="${data.mediaUrl}" alt="صورة النشاط"></div>`;
          }
        }

        const card = document.createElement("div");
        card.className = "activity-card";
        card.innerHTML = `
          <div class="activity-header">
            <span class="teacher-name">👨‍🏫 الأستاذ: ${escapeHtml(data.teacher)}</span>
            <button class="delete-btn" onclick="deleteActivity('${id}')">🗑️ حذف النشاط</button>
          </div>
          <div class="activity-title">${escapeHtml(data.title)}</div>
          <div class="activity-info">🎯 <b>الفئة المستهدفة:</b> ${escapeHtml(data.target)}</div>
          <div class="activity-info">💡 <b>الهدف التربوي:</b> ${escapeHtml(data.goal)}</div>
          ${mediaHtml}
          <div class="card-footer">
            <button class="like-btn ${isLiked ? 'liked' : ''}" onclick="toggleLike('${id}')">
              ❤️ <span>أعجبني</span> (${data.likes || 0})
            </button>
            <span class="votes-counter">⭐ الترتيب يتحدث لحظياً</span>
          </div>
        `;
        container.appendChild(card);
      });
    });

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.innerText = text;
      return div.innerHTML;
    }
  </script>
</body>
</html>
